# Builds Parabol from source in a single `docker build`, for platforms like Coolify
# that build straight from the git repo. Mirrors .github/workflows/build.yml +
# docker/images/parabol-ubi/dockerfiles/basic.dockerfile.
# Node major must match "engines.node" in package.json.
ARG _NODE_MAJOR=26

FROM node:${_NODE_MAJOR} AS builder
WORKDIR /app
COPY . .
# corepack is no longer bundled with Node 25+, so install the pinned pnpm from "packageManager"
RUN npm install -g "$(node -p "require('./package.json').packageManager.split('+')[0]")"
RUN pnpm install --frozen-lockfile
# The build context has no .git, so the commit hash comes from Coolify's SOURCE_COMMIT
# ("Include Source Commit in Build"), else the build time, so each build stays distinct for the service worker
ARG SOURCE_COMMIT
RUN cp docker/images/parabol-ubi/environments/pipeline ./.env \
 && COMMIT_HASH="${SOURCE_COMMIT:-$(date +%s)}" NODE_OPTIONS=--max_old_space_size=8192 pnpm build --no-deps

# slim instead of distroless so the container has a shell to run migrations before starting
FROM node:${_NODE_MAJOR}-slim
ENV HOME=/home/node \
    PORT=3000
# Required for pushToCDN to work with FILE_STORE_PROVIDER set to 'local'
RUN mkdir -p /home/node/parabol/self-hosted && chown -R node:node /home/node/parabol
USER node
WORKDIR /home/node/parabol

# The application requires a pnpm-lock.yaml file on the root folder to identify it
COPY --from=builder --chown=node:node /app/.env.example /app/pnpm-lock.yaml ./
COPY --from=builder --chown=node:node /app/build ./build
COPY --from=builder --chown=node:node /app/dist ./dist

EXPOSE ${PORT}

# preDeploy waits for Postgres/Redis and runs migrations, then the web server starts
CMD ["sh", "-c", "node dist/preDeploy.js && exec node dist/web.js"]
